if [ $TUI -eq 1 ]; then
    check_dependencies
    go_tui
fi

case "$COMMAND" in
addtime) go_addtime
        ;;
reset) reset_time $KID
        ;;
gettime) get_time
        ;;
logout) go_logout_sync $KID
        ;;
kill) go_killall $KID
        ;;
recheck) go_recheck_logout $KID
        exit $?
        ;;
hourly) go_hourly
        ;;
daily) go_daily
        ;;
check) go_check
        ;;
info) get_info
        ;;
-h) go_help
        ;;
help) go_help
        ;;
esac
exit 0
